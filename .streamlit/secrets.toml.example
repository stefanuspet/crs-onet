# Salin berkas ini menjadi .streamlit/secrets.toml (jangan di-commit), atau tempel isinya
# di pengaturan "Secrets" aplikasi di Streamlit Community Cloud.

# Alamat Postgres daring (misalnya dari Supabase atau Neon). Kosongkan untuk memakai berkas SQLite lokal.
DATABASE_URL = "postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# Kata sandi halaman ekspor data (buka aplikasi dengan ?admin=1 di akhir alamat).
ADMIN_TOKEN = "ganti-dengan-kata-sandi-panjang"
